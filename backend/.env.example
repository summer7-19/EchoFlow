NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5174
STORAGE_DIR=storage
MAX_UPLOAD_MB=100
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=echoflow
REDIS_URL=redis://127.0.0.1:6380
AUDIO_QUEUE_NAME=audio-processing
AUDIO_QUEUE_CONCURRENCY=2
AUDIO_QUEUE_ATTEMPTS=3
AUDIO_QUEUE_BACKOFF_MS=2000
AUDIO_QUEUE_KEEP_COMPLETED=100
AUDIO_QUEUE_KEEP_FAILED=500
# Local FunASR engine (backend/asr_engine/server.py)
FUNASR_BASE_URL=http://localhost:8001
FUNASR_TIMEOUT_MS=300000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
